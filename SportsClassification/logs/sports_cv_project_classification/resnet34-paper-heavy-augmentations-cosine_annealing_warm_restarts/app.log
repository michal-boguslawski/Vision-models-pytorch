experiment_name: resnet34-paper-heavy-augmentations-cosine_annealing_warm_restarts
model:
  model_name: ResNet34
  num_classes: 100
  num_anchors: 3
  dropout_rate: 0.5
  hidden_dim: 4096
dataset:
  name: sports_images
  source: kaggle
  kaggle_dataset_name: gpiosenka/sports-classification
  force_download: false
  root_dir: data
  raw_subdir: raw
  processed_subdir: processed
  annotations_subdir: annotations
  annotations_file: sports.csv
  use_existing_train_test_split: true
  train_subdir: train
  val_subdir: val
  test_subdir: test
  input_size:
  - 224
  - 224
  normalize_mean:
  - 0.4714
  - 0.4699
  - 0.4551
  normalize_std:
  - 0.2391
  - 0.2302
  - 0.232
  augmentations:
    horizontal_flip: true
    rotation: true
    random_crop: false
    random_resized_crop: true
    color_jitter: true
    grayscale: true
    gaussian_blur: true
    perspective: false
    affine: true
    erasing: true
    adjust_sharpness: false
  batch_size: 128
  shuffle: true
  num_workers: 24
  seed: 42
checkpoints_dir: checkpoints/
logs_dir: logs/
training:
  optimizer:
    type: adam
    lr: 0.0002
    weight_decay: 0.001
  scheduler:
    type: cosine_annealing_warm_restarts
    T_0: 50
    T_mult: 2
  loss:
    type: cross_entropy
    label_smoothing: 0.05
    bbox_loss: smooth_l1
    obj_loss: binary_cross_entropy
  early_stopping:
    patience: 30
    reset_after: 50
    T_mult: 2
    threshold: 0.0001
  num_epochs: 1000
  save_best_only: true
  save_checkpoint: true
  log_interval: 50
evaluation:
  metrics:
  - accuracy
  - top-5-accuracy
  iou_threshold: 0.5
  conf_threshold: 0.3
misc:
  device: cuda
  seed: 42
  deterministic: true
s3_bucket: computer-vision-models-pytorch-bucket
dynamodb_config_table: computer-vision-models-config-table

